{
  "schemaVersion": 1,
  "configVersion": "2026.11.07-1",
  "minAppVersion": 1,

  "game": {
    "lives": 3,
    "maxLives": 3,
    "respawnInvulnerabilitySec": 2.0,
    "levelIntroSec": 1.5,
    "bossEveryNLevels": 5,
    "checkpointOffset": 2,
    "endlessMode": true,
    "wavesPerLevel": { "min": 3, "max": 6, "addOneEveryNLevels": 4 },
    "waveDelaySec": 1.5,
    "loseShipLevelOnDeath": true,
    "resetShipOnGameOver": true
  },

  "scaling": {
    "enemyCount": { "base": 12, "perLevel": 2, "max": 40 },
    "enemyHpMultiplier": { "growth": 1.15, "max": 60.0 },
    "fireInterval": { "baseSec": 2.5, "growth": 0.93, "minSec": 0.6 },
    "enemySpeed": { "perLevel": 0.03, "maxMultiplier": 1.6 },
    "bulletSpeed": { "perLevel": 0.02, "maxMultiplier": 1.5 },
    "scoreMultiplier": { "perLevel": 0.05 }
  },

  "enemyTypes": [
    {
      "id": "scout",
      "unlockLevel": 1,
      "baseHp": 3,
      "score": 10,
      "attack": { "pattern": "single", "shotsPerVolley": 1, "spreadDeg": 0, "aimed": false, "bulletSpeed": 4.0 },
      "movement": { "type": "formation", "speed": 1.0 },
      "spawnWeight": 10,
      "drops": { "power_core": 0.20, "coin": 0.40, "shield": 0.03, "rapid_fire": 0.03, "magnet": 0.02, "extra_life": 0.003 }
    },
    {
      "id": "fighter",
      "unlockLevel": 3,
      "baseHp": 6,
      "score": 20,
      "attack": { "pattern": "double", "shotsPerVolley": 2, "spreadDeg": 0, "aimed": false, "bulletSpeed": 4.5 },
      "movement": { "type": "formation_sway", "speed": 1.2, "swayAmplitude": 0.6 },
      "spawnWeight": 8,
      "drops": { "power_core": 0.25, "coin": 0.40, "shield": 0.04, "rapid_fire": 0.04, "magnet": 0.03, "extra_life": 0.005 }
    },
    {
      "id": "bomber",
      "unlockLevel": 5,
      "baseHp": 12,
      "score": 40,
      "attack": { "pattern": "spread", "shotsPerVolley": 3, "spreadDeg": 30, "aimed": false, "bulletSpeed": 3.5 },
      "movement": { "type": "hold", "speed": 0.6 },
      "spawnWeight": 4,
      "drops": { "power_core": 0.35, "coin": 0.45, "shield": 0.06, "rapid_fire": 0.05, "magnet": 0.04, "extra_life": 0.008 }
    },
    {
      "id": "interceptor",
      "unlockLevel": 10,
      "baseHp": 8,
      "score": 35,
      "attack": { "pattern": "single", "shotsPerVolley": 1, "spreadDeg": 0, "aimed": true, "bulletSpeed": 5.5 },
      "movement": { "type": "dive", "speed": 2.2, "diveChancePerSec": 0.15 },
      "spawnWeight": 5,
      "drops": { "power_core": 0.30, "coin": 0.40, "shield": 0.05, "rapid_fire": 0.05, "magnet": 0.03, "extra_life": 0.006 }
    },
    {
      "id": "elite",
      "unlockLevel": 15,
      "baseHp": 25,
      "score": 80,
      "attack": { "pattern": "burst_aimed", "shotsPerVolley": 4, "spreadDeg": 12, "aimed": true, "bulletSpeed": 5.0 },
      "movement": { "type": "strafe", "speed": 1.6 },
      "spawnWeight": 2,
      "drops": { "power_core": 0.50, "coin": 0.50, "shield": 0.08, "rapid_fire": 0.08, "magnet": 0.05, "extra_life": 0.01 }
    }
  ],

  "bosses": {
    "hpBase": 120,
    "scoreBase": 1000,
    "powerCoreDrops": 5,
    "guaranteedDrops": ["shield"],
    "enrageBelowHpPercent": 30,
    "enrageFireRateBonus": 0.5,
    "types": [
      { "id": "crab_dreadnought", "phases": ["spread_fan", "aimed_burst"], "moveSpeed": 1.0 },
      { "id": "hive_carrier", "phases": ["spawn_scouts", "spread_fan"], "moveSpeed": 0.8 },
      { "id": "laser_cruiser", "phases": ["sweep_laser", "aimed_burst"], "moveSpeed": 1.2 },
      { "id": "nebula_titan", "phases": ["spiral", "spread_fan", "aimed_burst"], "moveSpeed": 0.9 }
    ]
  },

  "formations": {
    "grid": { "rowSpacing": 0.9, "colSpacing": 0.8 },
    "v": { "spacing": 0.8 },
    "line": { "spacing": 0.8 },
    "circle": { "radius": 1.8 },
    "entryPaths": ["top", "left_arc", "right_arc", "zigzag"]
  },

  "levels": [
    {
      "level": 1,
      "waves": [
        { "formation": "grid", "rows": 2, "cols": 4, "enemy": "scout", "entry": "top", "delaySec": 0 },
        { "formation": "v", "count": 5, "enemy": "scout", "entry": "left_arc", "delaySec": 1.5 },
        { "formation": "grid", "rows": 1, "cols": 4, "enemy": "scout", "entry": "right_arc", "delaySec": 1.5 }
      ]
    },
    {
      "level": 2,
      "waves": [
        { "formation": "grid", "rows": 3, "cols": 4, "enemy": "scout", "entry": "top", "delaySec": 0 },
        { "formation": "line", "count": 6, "enemy": "scout", "entry": "zigzag", "delaySec": 1.5 },
        { "formation": "v", "count": 5, "enemy": "scout", "entry": "right_arc", "delaySec": 1.5 }
      ]
    },
    {
      "level": 3,
      "waves": [
        { "formation": "grid", "rows": 2, "cols": 4, "enemy": "scout", "entry": "top", "delaySec": 0 },
        { "formation": "v", "count": 5, "enemy": "fighter", "entry": "left_arc", "delaySec": 1.5 },
        { "formation": "circle", "count": 8, "enemy": "scout", "entry": "top", "delaySec": 1.5 },
        { "formation": "line", "count": 4, "enemy": "fighter", "entry": "right_arc", "delaySec": 1.5 }
      ]
    }
  ],

  "player": {
    "moveSpeed": 12.0,
    "touchOffsetY": 1.2,
    "hitboxRadius": 0.25,
    "shipLevels": [
      { "level": 1, "coresRequired": 0,  "damage": 1, "fireRate": 6,  "pattern": "single",        "bulletSpeed": 12.0, "missiles": false },
      { "level": 2, "coresRequired": 5,  "damage": 1, "fireRate": 7,  "pattern": "double",        "bulletSpeed": 12.5, "missiles": false },
      { "level": 3, "coresRequired": 12, "damage": 2, "fireRate": 8,  "pattern": "double_side",   "bulletSpeed": 13.0, "missiles": false },
      { "level": 4, "coresRequired": 22, "damage": 2, "fireRate": 9,  "pattern": "triple_spread", "bulletSpeed": 13.5, "missiles": false },
      { "level": 5, "coresRequired": 35, "damage": 3, "fireRate": 10, "pattern": "five_spread",   "bulletSpeed": 14.0, "missiles": false },
      { "level": 6, "coresRequired": 50, "damage": 4, "fireRate": 11, "pattern": "five_spread",   "bulletSpeed": 14.5, "missiles": true, "missileIntervalSec": 1.2, "missileDamage": 6 }
    ],
    "extraCoreScoreAtMax": 50
  },

  "collectables": [
    { "id": "power_core", "fallSpeed": 2.0, "value": 1 },
    { "id": "shield",     "fallSpeed": 2.0, "durationSec": 15, "hits": 1 },
    { "id": "rapid_fire", "fallSpeed": 2.0, "durationSec": 8,  "fireRateBonus": 0.5 },
    { "id": "magnet",     "fallSpeed": 2.0, "durationSec": 10, "radius": 6.0 },
    { "id": "extra_life", "fallSpeed": 1.6, "maxPerLevel": 1 },
    { "id": "coin",       "fallSpeed": 2.4, "score": 25 }
  ],

  "scoring": {
    "comboWindowSec": 1.0,
    "comboStep": 0.5,
    "comboMaxMultiplier": 5.0,
    "noDamageBonus": 500,
    "starsByLivesLost": [3, 2, 1]
  },

  "ads": {
    "enabled": true,
    "bannerScreens": ["main_menu", "level_select", "rankings", "settings", "pause", "game_over"],
    "interstitialEveryNLevels": 3,
    "interstitialMinGapSec": 90,
    "interstitialAfterRevive": false,
    "revivesPerRun": 1,
    "reviveCountdownSec": 5,
    "reviveLives": 1
  },

  "features": {
    "bombEnabled": false,
    "bombsPerLevel": 1,
    "playGamesEnabled": true,
    "rankingsEnabled": true,
    "achievementsEnabled": true,
    "vibrationDefault": false
  },

  "store": {
    "packageName": "com.fuino.galaxy.shooter.game",
    "updateUrl": "https://play.google.com/store/apps/details?id=com.fuino.galaxy.shooter.game"
  }
}
